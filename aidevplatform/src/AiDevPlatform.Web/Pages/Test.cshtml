@page
@model AiDevPlatform.Web.Pages.TestModel
@{
    ViewData["Title"] = "测试页面";
}

<div class="text-center">
    <h1 class="display-4">测试页面</h1>
    <p class="lead">这是一个测试页面，用于验证样式是否正常工作。</p>

    <div class="row mt-5">
        <div class="col-md-6">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">测试卡片</h5>
                    <p class="card-text">这是一个测试卡片，用于验证 Bootstrap 样式。</p>
                    <button class="btn btn-primary">主要按钮</button>
                    <button class="btn btn-success">成功按钮</button>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">另一个测试卡片</h5>
                    <p class="card-text">这是另一个测试卡片。</p>
                    <button class="btn btn-info">信息按钮</button>
                    <button class="btn btn-warning">警告按钮</button>
                </div>
            </div>
        </div>
    </div>
</div>
