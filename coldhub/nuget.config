<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- 包源只在这里定义，且每个包只映射到一个源（packageSourceMapping） -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
